{
  "name": "sctelemetry",
  "version": "0.1.0",
  "description": "Star Citizen cockpit telemetry screens for tablets and phones on your local network",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "sim": "node --disable-warning=ExperimentalWarning server/index.js --source=sim",
    "fake-game": "node scripts/fake-game.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=20000 test/*.test.js",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "presim": "node scripts/check-node.cjs",
    "predev": "node scripts/check-node.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crypticsh/sctelemetry.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/crypticsh/sctelemetry/issues"
  },
  "homepage": "https://github.com/crypticsh/sctelemetry#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "protobufjs": "^8.8.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.59.1",
    "uplot": "^1.6.32",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
